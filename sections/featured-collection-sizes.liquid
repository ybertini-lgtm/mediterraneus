{% javascript %}
  if (!customElements.get('rq-collection')) {
    class RqCollection extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', this.onClick.bind(this));
        this.addEventListener('keydown', this.onKeydown.bind(this));
      }

      onClick(event) {
        const tab = event.target.closest('[data-rq-tab]');
        if (tab) return this.selectTab(tab);

        const step = event.target.closest('[data-rq-media-step]');
        if (step) {
          event.preventDefault();
          return this.stepMedia(step);
        }

        const slide = event.target.closest('[data-rq-slide]');
        if (slide) return this.slide(Number(slide.dataset.rqSlide));

        const toggle = event.target.closest('[data-rq-quick-toggle]');
        if (toggle) {
          const card = toggle.closest('.rq-card');
          const open = !card.classList.contains('is-open');
          this.querySelectorAll('.rq-card.is-open').forEach((c) => {
            c.classList.remove('is-open');
            c.querySelector('[data-rq-quick-toggle]')?.setAttribute('aria-expanded', 'false');
          });
          card.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          return;
        }

        const add = event.target.closest('[data-rq-add]');
        if (add) {
          event.preventDefault();
          this.addToCart(add);
        }
      }

      onKeydown(event) {
        const tab = event.target.closest('[data-rq-tab]');
        if (!tab || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        const tabs = Array.from(this.querySelectorAll('[data-rq-tab]'));
        const index = tabs.indexOf(tab);
        const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        next.focus();
        this.selectTab(next);
      }

      selectTab(tab) {
        this.querySelectorAll('[data-rq-tab]').forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
          t.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls'));
          if (panel) panel.hidden = !active;
        });
      }

      slide(direction) {
        const grid = this.querySelector('.rq-panel:not([hidden]) .rq-grid--slider');
        if (grid) grid.scrollBy({ left: direction * grid.clientWidth, behavior: 'smooth' });
      }

      stepMedia(button) {
        const link = button.closest('.rq-card__media').querySelector('.rq-card__media-link');
        const images = link.querySelectorAll('.rq-card__img');
        if (images.length < 2) return;
        const current = Number(link.dataset.active || 0);
        const next = (current + Number(button.dataset.rqMediaStep) + images.length) % images.length;
        images.forEach((img, i) => img.classList.toggle('is-active', i === next));
        link.classList.add('has-active');
        link.dataset.active = next;
      }

      async addToCart(button) {
        if (button.disabled || button.classList.contains('is-loading')) return;

        const card = button.closest('.rq-card');
        const status = card.querySelector('[data-rq-status]');
        const initialLabel = status ? status.textContent : '';
        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');

        const formData = new FormData();
        formData.append('id', button.dataset.variantId);
        formData.append('quantity', 1);
        if (cart && typeof cart.getSectionsToRender === 'function') {
          formData.append('sections', cart.getSectionsToRender().map((s) => s.id));
          formData.append('sections_url', window.location.pathname);
          if (typeof cart.setActiveElement === 'function') cart.setActiveElement(button);
        }

        const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        const addUrl = window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : root + 'cart/add';

        button.classList.add('is-loading');
        button.setAttribute('aria-busy', 'true');
        if (status) status.classList.remove('is-error');

        try {
          const response = await fetch(addUrl + '.js', {
            method: 'POST',
            headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: formData,
          });
          const data = await response.json();

          if (!response.ok || data.status) {
            if (status) {
              status.textContent = data.description || data.message || this.dataset.errorLabel;
              status.classList.add('is-error');
              setTimeout(() => {
                status.textContent = initialLabel;
                status.classList.remove('is-error');
              }, 3000);
            }
            return;
          }

          button.classList.add('is-added');
          if (status) status.textContent = this.dataset.addedLabel;
          setTimeout(() => {
            button.classList.remove('is-added');
            if (status) status.textContent = initialLabel;
          }, 2000);

          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, {
              source: 'rq-collection',
              productVariantId: button.dataset.variantId,
              cartData: data,
            });
          }

          if (cart && typeof cart.renderContents === 'function') {
            cart.classList.remove('is-empty');
            cart.renderContents(data);
          } else {
            window.location.href = (window.routes && window.routes.cart_url) || root + 'cart';
          }
        } catch (error) {
          console.error(error);
          if (status) {
            status.textContent = this.dataset.errorLabel;
            status.classList.add('is-error');
          }
        } finally {
          button.classList.remove('is-loading');
          button.removeAttribute('aria-busy');
        }
      }
    }

    customElements.define('rq-collection', RqCollection);
  }
{% endjavascript %}

