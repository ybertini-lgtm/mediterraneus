  @media screen and (min-width: 990px) {
    .rq-card__title { font-size: 1.5rem; }
  }
  .rq-card__title:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  .rq-card__price {
    margin: 0.6rem 0 0;
    font-size: 1.4rem;
